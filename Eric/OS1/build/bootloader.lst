   110 000000AB 57                          push di
   111 000000AC F3A6                        repe cmpsb
   112 000000AE 5F                          pop di
   113 000000AF 740D                        je .found_kernel
   114                                  
   115 000000B1 83C720                      add di, 32
   116 000000B4 43                          inc bx
   117 000000B5 3B1E[1100]                  cmp bx, [bdb_dir_entires_count]
   118 000000B9 7CEA                        jl .search_kernel
