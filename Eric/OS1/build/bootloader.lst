     1                                  org 0x7C00 
     2                                  bits 16
     3                                  
     4                                  %define ENDL 0x0D, 0X0A
     5                                  
     6                                  
     7                                  ;
     8                                  ; FAT12 header
     9                                  ; 
    10 00000000 EB3C                    jmp short start 
    11 00000002 90                      nop
    12                                  
    13 00000003 4D5357494E342E31        bdb_oem: db 'MSWIN4.1'
    14 0000000B 0002                    bdb_bytes_per_sector: dw 512
    15 0000000D 01                      bdb_sectors_per_cluster: db 1
    16 0000000E 0100                    bdb_reserved_sector: dw 1
    17 00000010 02                      bdb_fat_count: db 2
    18 00000011 E000                    bdb_dir_entires_count: dw 0E0h
    19 00000013 400B                    bdb_total_sectors: dw 2880
    20 00000015 F0                      bdb_media_descriptor_type: db 0F0h
    21 00000016 0900                    bdb_sectors_per_fat: dw 9
    22 00000018 1200                    bdb_sectors_per_track: dw 18
    23 0000001A 0200                    bdb_heads: dw 2
    24 0000001C 00000000                bdb_hidden_sectors: dd 0
    25 00000020 00000000                bdb_large_sector_count: dd 0
    26                                  
    27                                  ; Extended boot record
    28 00000024 00                      ebr_drive_number: db 0
    29 00000025 00                      db 0
    30 00000026 29                      ebr_signature: db 29h
    31 00000027 00000000                ebr_volume_id: db 0, 0, 0, 0
    32 0000002B 4E414E4F4259544520-     ebr_volume_label: db 'NANOBYTE OS' ; 11 bytes, padded with spaces
    32 00000034 4F53               
    33 00000036 4641543132202020        ebr_system_id: db 'FAT12   ' ; 8 bytes
    34                                  
    35                                  start:
    36 0000003E EB75                        jmp main
    37                                  
    38                                  ;
    39                                  ; Prints a string to the screen.
    40                                  ; Params:
    41                                  ;   - ds:si points to string
    42                                  puts:
    43 00000040 56                          push si
    44 00000041 50                          push ax
    45                                  
    46                                  .loop:
    47 00000042 AC                          lodsb
    48 00000043 08C0                        or al, al
    49 00000045 7408                        jz .done
    50                                  
    51 00000047 B40E                        mov ah, 0x0e
    52 00000049 B700                        mov bh, 0
    53 0000004B CD10                        int 0x10
    54 0000004D EBF3                        jmp .loop
    55                                  
    56                                  .done:
    57 0000004F 58                          pop ax
    58 00000050 5E                          pop si
    59 00000051 C3                          ret
    60                                  
    61                                  floppy_error:
    62 00000052 BE[DA00]                    mov si, msg_read_failed
    63 00000055 E8E8FF                      call puts
    64 00000058 EB00                        jmp wait_key_and_reboot
    65                                  
    66                                  wait_key_and_reboot:
    67 0000005A B400                        mov ah, 0
    68 0000005C CD16                        int 16h                     ;wait for keypress
    69 0000005E EA0000FFFF                  jmp 0FFFFh:0                ;jump to to beginning of BIOS, should reboot
    70                                  
    71                                  .halt:
    72 00000063 FA                          cli                         ;disable interrupts so we cant get cpu out of halt state
    73 00000064 F4                          hlt
    74                                  
    75                                  ;
    76                                  ; Converts LBA address to CHS address
    77                                  ; Params:
    78                                  ;   - ax: LBA address
    79                                  ; Returns:
    80                                  ;   - cx [bits 0-5]: sector number
    81                                  ;   - cx [bits 6-15]: cylinder
    82                                  ;   - dh: head
    83                                  ;
    84                                  
    85                                  lba_to_chs:
    86 00000065 50                          push ax
    87 00000066 52                          push dx
    88                                  
    89 00000067 31D2                        xor dx, dx
    90 00000069 F736[1800]                  div word [bdb_sectors_per_track]    ; ax = LBA / SectorsPerTrack
    91                                                                          ; dx = LBA % SectorsPerTrack
    92                                  
    93 0000006D 42                          inc dx
    94 0000006E 89D1                        mov cx, dx
    95                                  
    96 00000070 31D2                        xor dx, dx
    97 00000072 F736[1A00]                  div word [bdb_heads]
    98                                  
    99 00000076 88D6                        mov dh, dl
   100 00000078 88C5                        mov ch, al
   101 0000007A C0E406                      shl ah, 6
   102 0000007D 08E1                        or cl, ah
   103                                  
   104 0000007F 58                          pop ax
   105 00000080 88C2                        mov dl, al
   106 00000082 58                          pop ax
   107 00000083 C3                          ret
   108                                  
   109                                  
   110                                  ;
   111                                  ; Reads sectors from a disk
   112                                  ; Parameters:
   113                                  ; - ax: LBA address
   114                                  ; - cl: number of sectors to read (up to 128)
   115                                  ; - dl: drive number
   116                                  ; - es:bx: memory address where to store read data
   117                                  ;
   118                                  disk_read:
   119 00000084 50                          push ax
   120 00000085 53                          push bx
   121 00000086 51                          push cx
   122 00000087 52                          push dx
   123 00000088 57                          push di
   124                                  
   125 00000089 51                          push cx
   126 0000008A E8D8FF                      call lba_to_chs
   127 0000008D 58                          pop ax
   128                                      
   129                                  
   130 0000008E B402                        mov ah, 02h
   131 00000090 BF0300                      mov di, 3
   132                                  
   133                                  .retry:
   134 00000093 60                          pusha
   135 00000094 F9                          stc         ;set carry flag, some BIOSes don't set it
   136 00000095 CD13                        int 13h
   137 00000097 730B                        jnc .done
   138                                  
   139                                      ; read failed
   140 00000099 61                          popa
   141 0000009A E80E00                      call disk_reset
   142                                  
   143 0000009D 4F                          dec di
   144 0000009E 85FF                        test di, di
   145 000000A0 75F1                        jnz .retry
   146                                  
   147                                  .fail:
   148 000000A2 EBAE                        jmp floppy_error
   149                                  
   150                                  .done:
   151 000000A4 61                          popa
   152                                      
   153 000000A5 5F                          pop di
   154 000000A6 5A                          pop dx
   155 000000A7 59                          pop cx
   156 000000A8 5B                          pop bx
   157 000000A9 58                          pop ax
   158 000000AA C3                          ret
   159                                  
   160                                  
   161                                  ;
   162                                  ; resets disk controller
   163                                  ; Params:
   164                                  ;   dl: drive number
   165                                  ;
   166                                  disk_reset:
   167 000000AB 60                          pusha
   168 000000AC B400                        mov ah, 0
   169 000000AE F9                          stc
   170 000000AF CD13                        int 13h
   171 000000B1 729F                        jc floppy_error
   172 000000B3 61                          popa
   173 000000B4 C3                          ret
   174                                  
   175                                  
   176                                  main:
   177                                      ;setup data segments
   178 000000B5 B80000                      mov ax, 0
   179 000000B8 8ED8                        mov ds, ax
   180 000000BA 8EC0                        mov es, ax
   181                                  
   182                                      ;setup stack
   183 000000BC 8ED0                        mov ss, ax
   184 000000BE BC007C                      mov sp, 0x7C00
   185                                  
   186                                      ;read something from floppy disk
   187                                      ;BIOS should set DL to drive number
   188 000000C1 8816[2400]                  mov [ebr_drive_number], dl
   189                                  
   190 000000C5 B80100                      mov ax, 1           ;LBA=1, second sector from disk
   191 000000C8 B101                        mov cl, 1           ;1 sector to read
   192 000000CA BB007E                      mov bx, 0x7E00      ;data should be after the bootloader
   193 000000CD E8B4FF                      call disk_read
   194                                  
   195 000000D0 BE[F300]                    mov si, msg_hello
   196 000000D3 E86AFF                      call puts
   197                                  
   198 000000D6 FA                          cli ;disable interrupts
   199 000000D7 F4                          hlt
   200                                  
   201                                  .halt:
   202 000000D8 EBFE                        jmp .halt
   203                                  
   204                                  
   205 000000DA 526561642066726F6D-     msg_read_failed: db 'Read from disk failed!', ENDL, 0
   205 000000E3 206469736B20666169-
   205 000000EC 6C6564210D0A00     
   206 000000F3 48656C6C6F20576F72-     msg_hello: db 'Hello World!', ENDL, 0
   206 000000FC 6C64210D0A00       
   207                                  
   208 00000102 00<rep FCh>             times 510-($-$$) db 0
   209 000001FE 55AA                    dw 0AA55h
