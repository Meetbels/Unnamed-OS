   163                                  
   164 00000105 09D2                        or dx, dx
   165 00000107 7405                        jz .even
   166                                  
   167                                  .odd:
   168 00000109 C1E804                      shr ax, 4
   169 0000010C EB03                        jmp .next_cluster_after
   170                                  
   171                                  .even:
