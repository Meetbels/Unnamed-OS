   243                                  ;
   244                                  ; Converts LBA address to CHS address
   245                                  ; Params:
   246                                  ;   - ax: LBA address
   247                                  ; Returns:
   248                                  ;   - cx [bits 0-5]: sector number
   249                                  ;   - cx [bits 6-15]: cylinder
   250                                  ;   - dh: head
   251                                  ;
   252                                  
   253                                  lba_to_chs:
   254 0000015C 50                          push ax
   255 0000015D 52                          push dx
   256                                  
   257 0000015E 31D2                        xor dx, dx
   258 00000160 F736[1800]                  div word [bdb_sectors_per_track]    ; ax = LBA / SectorsPerTrack
   259                                                                          ; dx = LBA % SectorsPerTrack
   260                                  
   261 00000164 42                          inc dx
   262 00000165 89D1                        mov cx, dx
   263                                  
   264 00000167 31D2                        xor dx, dx
   265 00000169 F736[1A00]                  div word [bdb_heads]
   266                                  
   267 0000016D 88D6                        mov dh, dl
   268 0000016F 88C5                        mov ch, al
   269 00000171 C0E406                      shl ah, 6
   270 00000174 08E1                        or cl, ah
   271                                  
   272 00000176 58                          pop ax
   273 00000177 88C2                        mov dl, al
   274 00000179 58                          pop ax
   275 0000017A C3                          ret
   276                                  
   277                                  
   278                                  ;
   279                                  ; Reads sectors from a disk
   280                                  ; Parameters:
   281                                  ; - ax: LBA address
   282                                  ; - cl: number of sectors to read (up to 128)
   283                                  ; - dl: drive number
   284                                  ; - es:bx: memory address where to store read data
   285                                  ;
   286                                  disk_read:
   287 0000017B 50                          push ax
   288 0000017C 53                          push bx
   289 0000017D 51                          push cx
   290 0000017E 52                          push dx
   291 0000017F 57                          push di
   292                                  
   293 00000180 51                          push cx
   294 00000181 E8D8FF                      call lba_to_chs
   295 00000184 58                          pop ax
   296                                      
   297                                  
   298 00000185 B402                        mov ah, 02h
   299 00000187 BF0300                      mov di, 3
   300                                  
   301                                  .retry:
   302 0000018A 60                          pusha
   303 0000018B F9                          stc         ;set carry flag, some BIOSes don't set it
   304 0000018C CD13                        int 13h
   305 0000018E 730B                        jnc .done
   306                                  
