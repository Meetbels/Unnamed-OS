    91 00000092 40                          inc ax
    92                                  
    93                                  
    94                                  .root_dir_after:
    95                                  
    96 00000093 88C1                        mov cl, al
    97 00000095 58                          pop ax
    98 00000096 8A16[2400]                  mov dl, [ebr_drive_number]
    99                                  
   100 0000009A BB[F901]                    mov bx, buffer                 
   101 0000009D E8DB00                      call disk_read
