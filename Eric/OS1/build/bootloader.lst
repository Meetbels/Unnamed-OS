   129 000000C7 BB[F901]                    mov bx, buffer
   130 000000CA 8A0E[1600]                  mov cl, [bdb_sectors_per_fat]
   131 000000CE 8A16[2400]                  mov dl, [ebr_drive_number]
   132 000000D2 E8A600                      call disk_read
   133                                  
   134                                      ;read kernel and process FAT chain
   135 000000D5 BB0020                      mov bx, KERNEL_LOAD_SEGMENT
   136 000000D8 8EC3                        mov es, bx
   137 000000DA BB0000                      mov bx, KERNEL_LOAD_OFFSET
   138                                  
   139                                  .load_kernel_loop:
   140                                  
   141 000000DD A1[F701]                    mov ax, [kernel_cluster]
   142                                  
   143                                      ;bad hardcoded value
   144 000000E0 83C01F                      add ax, 31
   145                                  
   146 000000E3 B101                        mov cl, 1
   147 000000E5 8A16[2400]                  mov dl, [ebr_drive_number]
   148 000000E9 E88F00                      call disk_read
   149                                  
   150 000000EC 031E[0B00]                  add bx, [bdb_bytes_per_sector]
   151                                  
   152                                  
   153                                      ;compute location of next cluster
   154 000000F0 A1[F701]                    mov ax, [kernel_cluster]
   155 000000F3 B90300                      mov cx, 3
   156 000000F6 F7E1                        mul cx
